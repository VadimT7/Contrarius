# Contrarius Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contrarius
DB_USER=contrarius_user
DB_PASSWORD=your_secure_password

# API Keys
ODDS_API_KEY=your_odds_api_key_here
SPORTRADAR_KEY=your_sportradar_key_here
BETFAIR_USERNAME=your_betfair_username
BETFAIR_PASSWORD=your_betfair_password
BETFAIR_APP_KEY=your_betfair_app_key
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
WEATHER_API_KEY=your_openweathermap_key

# Betting Configuration
MIN_EDGE_PERCENTAGE=5.0
MAX_BET_PERCENTAGE=5.0
KELLY_FRACTION=0.25
MAX_DAILY_BETS=20
MAX_EXPOSURE_PERCENTAGE=25.0
INITIAL_BANKROLL=10000.0
STOP_LOSS_PERCENTAGE=20.0
TAKE_PROFIT_PERCENTAGE=50.0

# System Configuration
UPDATE_INTERVAL_SECONDS=60
ENABLE_NOTIFICATIONS=false
NOTIFICATION_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
TIMEZONE=UTC
STEALTH_MODE=true 